{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelstudio.local/schema/project.schema.json",
  "title": "Reel Studio project",
  "description": "project.json schemaVersion 1 (docs/architecture.md section 3). Times are seconds. B-roll uses word IDs or source-time ranges; zooms, music automation and caption overrides use word IDs, never output seconds. Optional fields may be added; nothing is ever removed or renamed.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "slug", "format", "sources", "cut"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "slug": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "exposure": { "type": "number", "minimum": 0.125, "maximum": 8, "description": "linear footage exposure multiplier, limited to ffmpeg exposure's -3 to +3 stops; absent means 1" },
    "beatAccents": { "type": "boolean", "description": "Snap SFX hits and b-roll starts to detected music beats within 0.12 seconds. true: always; false: never, even when cutStyle.preset is hyper; absent: only when cutStyle.preset is hyper. Speech cuts never move; b-roll keeps its word lead." },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "path": { "$ref": "#/$defs/relPath" },
          "duration": { "type": "number", "minimum": 0 },
          "fps": { "type": "number", "minimum": 0 },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 },
          "rotation": { "type": "integer" },
          "originalName": { "type": "string" },
          "hdr": { "type": "boolean" },
          "mirror": { "type": "boolean", "description": "the take is mirrored (a front-camera selfie: on-screen text reads backwards): the render flips the picture left to right. Absent = false" },
          "angleOf": {
            "type": "object", "required": ["source", "offset"],
            "description": "this source is another camera on the recording of `source`: what that source shows at second t, this one shows at t + offset (reelengine sync-angles finds it by their sound). Its picture can replace the main one's; the words and the sound stay on the main take",
            "properties": {
              "source": { "type": "string", "pattern": "^s[0-9]+$" },
              "offset": { "type": "number" },
              "confidence": { "type": "number", "description": "how far the sound's best match stood out from the next (sync-angles)" }
            }
          }
        }
      }
    },
    "transcript": {
      "type": ["object", "null"],
      "properties": {
        "file": { "const": "work/transcript.json", "description": "always work/transcript.json; the engine never reads or writes another path" },
        "language": { "type": ["string", "null"] },
        "model": { "type": "string" }
      }
    },
    "cutStyle": {
      "type": "object",
      "required": ["preset", "seed"],
      "properties": {
        "preset": { "enum": ["clean", "standard", "hyper", "punchline"] },
        "seed": { "type": "integer" }
      }
    },
    "cut": {
      "type": "object",
      "required": ["keep"],
      "properties": {
        "keep": {
          "type": "array",
          "prefixItems": [{
            "if": { "required": ["clip"] },
            "then": { "$ref": "#/$defs/clip" },
            "else": { "$ref": "#/$defs/wordRange", "not": { "required": ["join"] },
              "properties": { "angle": { "type": "string", "pattern": "^s[0-9]+$" } } }
          }],
          "items": {
            "if": { "required": ["clip"] },
            "then": { "$ref": "#/$defs/clip" },
            "else": { "$ref": "#/$defs/wordRange", "properties": { "join": { "$ref": "#/$defs/join" },
              "angle": { "type": "string", "pattern": "^s[0-9]+$", "description": "show this camera (a source with angleOf on this range's take) for the range" } } }
          }
        },
        "gapCap": { "type": "number", "minimum": 0, "maximum": 5 },
        "minSaving": { "type": "number", "minimum": 0, "maximum": 2 },
        "source": { "type": "string", "description": "who wrote the cut: autocut | ai | user" },
        "angles": { "enum": ["auto", "off"], "description": "auto: switch the picture between the cameras of a recording (sources with angleOf) at cuts, by whose face fills more of the frame; off or absent: only a keep item's own angle" }
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "style": {
          "type": "object",
          "properties": {
            "preset": { "type": "string" },
            "font": { "type": "string" },
            "size": { "type": "number", "minimum": 10, "maximum": 300 },
            "sizePicked": { "type": "boolean", "description": "the person picked size in Edit it myself, so a new look keeps it (absent = the look's own size)" },
            "maxWords": { "type": "integer", "minimum": 1, "maximum": 12 },
            "case": { "enum": ["upper", "lower", "as-is", "title"] },
            "color": { "$ref": "#/$defs/color" },
            "outline": { "type": "number", "minimum": 0, "maximum": 40 },
            "outlineColor": { "$ref": "#/$defs/color" },
            "shadow": { "type": "number", "minimum": 0, "maximum": 40 },
            "position": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
            "box": { "type": "boolean", "description": "draw the words on a solid box in outlineColor" },
            "highlight": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "colour of the word being spoken (absent = no word highlight)" },
            "pop": { "type": "boolean", "description": "each line grows into place as it appears" }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string" },
              "at": { "$ref": "#/$defs/wordId", "description": "fix only this word, while it is still heard as `from` (empty `to` takes it off the captions)" },
              "through": { "$ref": "#/$defs/wordId", "description": "with `at`: the words from `at` through this one become one word" }
            }
          }
        },
        "hidden": {
          "type": "array",
          "description": "word-id ranges whose captions are suppressed (e.g. under a full-frame card)",
          "items": { "$ref": "#/$defs/wordRange" }
        },
        "split": { "type": "array", "description": "words that start a new caption line", "items": { "$ref": "#/$defs/wordId" } },
        "join": { "type": "array", "description": "the caption line starting at `to` goes onto the line ending at `from`", "items": { "$ref": "#/$defs/wordRange" } }
      }
    },
    "music": {
      "type": ["object", "null"],
      "properties": {
        "enabled": { "type": "boolean" },
        "track": { "anyOf": [{ "$ref": "#/$defs/relPath" }, { "type": "null" }] },
        "frozen": {
          "type": "object",
          "description": "the AI's frozen copy of a Library song; the engine plays path instead of track only while this track equals music.track",
          "required": ["track", "path"],
          "properties": {
            "track": { "$ref": "#/$defs/relPath" },
            "path": { "$ref": "#/$defs/relPath" }
          }
        },
        "startAt": { "type": "number", "minimum": 0 },
        "level": { "type": "string" },
        "automation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fromWord", "toWord", "gainDb"],
            "properties": {
              "fromWord": { "$ref": "#/$defs/wordId" },
              "toWord": { "$ref": "#/$defs/wordId" },
              "gainDb": { "type": "number", "minimum": -60, "maximum": 24 }
            }
          }
        },
        "fadeIn": { "type": "number", "minimum": 0, "maximum": 30, "description": "seconds the song takes to come in (absent = 0.6, or 0.05 with level loud-intro)" },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 30 }
      }
    },
    "broll": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "anchor", "treatment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "also part of layer file names: no paths" },
          "anchor": { "oneOf": [{ "$ref": "#/$defs/wordRange" }, { "$ref": "#/$defs/sourceRange" }] },
          "leadIn": { "type": "number" },
          "treatment": { "type": "string" },
          "asset": { "anyOf": [{ "$ref": "#/$defs/relPath" }, { "type": "null" }] },
          "params": { "type": "object" }
        }
      }
    },
    "zooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchor"],
        "properties": {
          "anchor": { "$ref": "#/$defs/wordRange" },
          "scale": { "type": "number", "minimum": 1, "maximum": 3 },
          "kind": { "enum": ["punch", "snap", "drift"] },
          "style": { "enum": ["snap"], "description": "snap = eased punch-in and release with motion blur; absent = hard cut" }
        }
      }
    },
    "sfx": {
      "type": "array",
      "description": "sound effects from the built-in pack (reelengine/sfx/pack.json), each hitting on one moment",
      "items": {
        "type": "object",
        "required": ["at", "sound"],
        "properties": {
          "at": {
            "type": "object",
            "description": "exactly one of: word (that word starts), broll (that b-roll appears), cut (the cut into the kept range that starts with that word)",
            "properties": {
              "word": { "$ref": "#/$defs/wordId" },
              "broll": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
              "cut": { "$ref": "#/$defs/wordId" }
            },
            "oneOf": [{ "required": ["word"] }, { "required": ["broll"] }, { "required": ["cut"] }]
          },
          "sound": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "gainDb": { "type": "number", "minimum": -24, "maximum": 12 }
        }
      }
    },
    "cover": {
      "type": ["object", "null"],
      "properties": {
        "atSourceTime": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "exact": { "type": ["boolean", "null"] },
        "manual": { "type": ["boolean", "null"] }
      }
    },
    "post": {
      "type": ["object", "null"],
      "properties": {
        "caption": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" }, "maxItems": 30 },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "text": { "type": "string" },
          "applied": { "type": "array", "items": { "type": "string" } },
          "at": { "type": "string" },
          "attachments": {
            "type": "array",
            "maxItems": 4,
            "description": "files the user attached to this note (work/assets/attach-*), placed by the AI with add_broll",
            "items": { "$ref": "#/$defs/relPath" }
          },
          "id": { "type": "string", "description": "the app's job id for this note" },
          "reply": { "type": "string", "description": "what the editor told the user about this note" },
          "styleRulesAdded": { "type": "array", "items": { "type": "string" }, "description": "My style rules the note asked to remember" },
          "styleSuggestions": { "type": "array", "items": { "type": "string" }, "description": "My style rules the AI proposed" },
          "receipt": {
            "type": "object",
            "description": "what the render that made this note's version changed since the version before it",
            "required": ["jobId", "renderId", "version", "facts"],
            "properties": {
              "jobId": { "type": ["string", "null"] },
              "renderId": { "type": "string" },
              "version": { "type": "integer" },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "before", "after"],
                  "properties": {
                    "kind": { "type": "string", "description": "the project.json path that changed, e.g. cut.keep, captions.style, broll" },
                    "field": { "type": "string", "description": "captions.style only: the style key" },
                    "id": { "type": "string", "description": "broll and source only: the item's id" },
                    "before": {},
                    "after": {}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "wordId": { "type": "string", "pattern": "^w[0-9]+$" },
    "join": {
      "type": "object",
      "required": ["transition", "frames"],
      "properties": {
        "transition": { "enum": ["hard", "j", "l", "smash", "match", "flash", "action"] },
        "frames": { "type": "integer", "minimum": 0 }
      }
    },
    "wordRange": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/wordId" }, "to": { "$ref": "#/$defs/wordId" } }
    },
    "clip": {
      "type": "object",
      "required": ["clip", "source", "in", "out"],
      "not": { "anyOf": [{ "required": ["from"] }, { "required": ["to"] }] },
      "properties": {
        "clip": { "type": "string", "pattern": "^c[0-9]+$" },
        "source": { "type": "string", "pattern": "^s[0-9]+$" },
        "in": { "type": "number", "minimum": 0 },
        "out": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "sourceRange": {
      "type": "object",
      "required": ["source", "s", "e"],
      "properties": {
        "source": { "type": "string", "pattern": "^s[0-9]+$" },
        "s": { "type": "number", "minimum": 0 },
        "e": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "description": "relative to the project (media/..., work/...) or the Reel Studio root (Library/...). No absolute, drive, UNC or '..' paths: the engine also re-checks the resolved real path.",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!(.*[\\\\/])?\\.\\.([\\\\/]|$))[^\\u0000]+$"
    }
  }
}
