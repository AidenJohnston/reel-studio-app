{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelstudio.local/schema/project.schema.json",
  "title": "Reel Studio project",
  "description": "project.json schemaVersion 1 (docs/architecture.md section 3). Times are seconds. B-roll, zooms, music automation and caption overrides are anchored to transcript WORD IDs, never output seconds. Optional fields may be added; nothing is ever removed or renamed.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "slug", "format", "sources", "cut"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "slug": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "version": { "type": "integer", "minimum": 0 },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "path": { "$ref": "#/$defs/relPath" },
          "duration": { "type": "number", "minimum": 0 },
          "fps": { "type": "number", "minimum": 0 },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 },
          "rotation": { "type": "integer" },
          "originalName": { "type": "string" },
          "hdr": { "type": "boolean" },
          "mirror": { "type": "boolean", "description": "the take is mirrored (a front-camera selfie: on-screen text reads backwards): the render flips the picture left to right. Absent = false" }
        }
      }
    },
    "transcript": {
      "type": ["object", "null"],
      "properties": {
        "file": { "const": "work/transcript.json", "description": "always work/transcript.json; the engine never reads or writes another path" },
        "language": { "type": ["string", "null"] },
        "model": { "type": "string" }
      }
    },
    "cut": {
      "type": "object",
      "required": ["keep"],
      "properties": {
        "keep": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "$ref": "#/$defs/wordId" },
              "to": { "$ref": "#/$defs/wordId" }
            }
          }
        },
        "gapCap": { "type": "number", "minimum": 0, "maximum": 5 },
        "minSaving": { "type": "number", "minimum": 0, "maximum": 2 },
        "source": { "type": "string", "description": "who wrote the cut: autocut | ai | user" }
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "style": {
          "type": "object",
          "properties": {
            "preset": { "type": "string" },
            "font": { "type": "string" },
            "size": { "type": "number", "minimum": 10, "maximum": 300 },
            "maxWords": { "type": "integer", "minimum": 1, "maximum": 12 },
            "case": { "enum": ["upper", "lower", "as-is", "title"] },
            "color": { "$ref": "#/$defs/color" },
            "outline": { "type": "number", "minimum": 0, "maximum": 40 },
            "outlineColor": { "$ref": "#/$defs/color" },
            "shadow": { "type": "number", "minimum": 0, "maximum": 40 },
            "position": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
            "box": { "type": "boolean", "description": "draw the words on a solid box in outlineColor" }
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string" },
              "at": { "$ref": "#/$defs/wordId", "description": "fix only this word, while it is still heard as `from` (empty `to` takes it off the captions)" },
              "through": { "$ref": "#/$defs/wordId", "description": "with `at`: the words from `at` through this one become one word" }
            }
          }
        },
        "hidden": {
          "type": "array",
          "description": "word-id ranges whose captions are suppressed (e.g. under a full-frame card)",
          "items": { "$ref": "#/$defs/wordRange" }
        },
        "split": { "type": "array", "description": "words that start a new caption line", "items": { "$ref": "#/$defs/wordId" } },
        "join": { "type": "array", "description": "the caption line starting at `to` goes onto the line ending at `from`", "items": { "$ref": "#/$defs/wordRange" } }
      }
    },
    "music": {
      "type": ["object", "null"],
      "properties": {
        "enabled": { "type": "boolean" },
        "track": { "anyOf": [{ "$ref": "#/$defs/relPath" }, { "type": "null" }] },
        "startAt": { "type": "number", "minimum": 0 },
        "level": { "type": "string" },
        "automation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fromWord", "toWord", "gainDb"],
            "properties": {
              "fromWord": { "$ref": "#/$defs/wordId" },
              "toWord": { "$ref": "#/$defs/wordId" },
              "gainDb": { "type": "number", "minimum": -60, "maximum": 24 }
            }
          }
        },
        "fadeOut": { "type": "number", "minimum": 0, "maximum": 30 }
      }
    },
    "broll": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "anchor", "treatment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "also part of layer file names: no paths" },
          "anchor": { "$ref": "#/$defs/wordRange" },
          "leadIn": { "type": "number" },
          "treatment": { "type": "string" },
          "asset": { "anyOf": [{ "$ref": "#/$defs/relPath" }, { "type": "null" }] },
          "params": { "type": "object" }
        }
      }
    },
    "zooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchor", "scale"],
        "properties": {
          "anchor": { "$ref": "#/$defs/wordRange" },
          "scale": { "type": "number", "minimum": 1, "maximum": 3 }
        }
      }
    },
    "cover": {
      "type": ["object", "null"],
      "properties": {
        "atSourceTime": { "type": ["number", "null"], "minimum": 0 },
        "source": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "exact": { "type": ["boolean", "null"] }
      }
    },
    "post": {
      "type": ["object", "null"],
      "properties": {
        "caption": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" }, "maxItems": 30 },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "integer" },
          "text": { "type": "string" },
          "applied": { "type": "array", "items": { "type": "string" } },
          "at": { "type": "string" },
          "attachments": {
            "type": "array",
            "maxItems": 4,
            "description": "files the user attached to this note (work/assets/attach-*), placed by the AI with add_broll",
            "items": { "$ref": "#/$defs/relPath" }
          },
          "id": { "type": "string", "description": "the app's job id for this note" },
          "reply": { "type": "string", "description": "what the editor told the user about this note" },
          "styleRulesAdded": { "type": "array", "items": { "type": "string" }, "description": "My style rules the note asked to remember" },
          "styleSuggestions": { "type": "array", "items": { "type": "string" }, "description": "My style rules the AI proposed" }
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "The Plan document (docs/plan.md, ai/src/plan.ts): what the creator and the AI agree on before the first edit. The engine renders `broll`, which the AI layer derives from plan.broll deterministically; it never reads this section itself.",
      "required": ["script", "beats", "broll"],
      "properties": {
        "script": {
          "type": "object",
          "required": ["draft", "rewrite", "locked"],
          "properties": {
            "draft": { "type": ["string", "null"], "description": "the AI's draft, kept so a UI can show a redline against the rewrite" },
            "rewrite": { "type": ["string", "null"], "description": "the creator's own rewrite; null until they rewrite it" },
            "locked": { "type": "boolean", "description": "locked to shoot: the draft and the rewrite no longer change until it is unlocked" },
            "lockedAt": { "type": "string" },
            "hook": { "type": "string", "description": "the draft's first spoken line" },
            "onScreenText": { "type": "array", "items": { "type": "string" } }
          }
        },
        "beats": {
          "type": "array",
          "description": "the script plan, one row of `| # | Line | Visual | Sound |` each",
          "items": {
            "type": "object",
            "required": ["line"],
            "properties": { "line": { "type": "string" }, "visual": { "type": "string" }, "sound": { "type": "string" } }
          }
        },
        "broll": {
          "type": "array",
          "description": "the b-roll plan, word to visual. Rows that are approved (or proposed, with buildProposed) and have their words and file are built as project broll items",
          "items": {
            "type": "object",
            "required": ["id", "visual", "source", "status"],
            "properties": {
              "id": { "type": "string", "pattern": "^p[0-9]+$" },
              "words": { "type": "string", "description": "the script words it goes over" },
              "anchor": { "$ref": "#/$defs/wordRange", "description": "the same words in the transcript, once there is one" },
              "visual": { "type": "string", "description": "what is on screen, in one line (a card's text)" },
              "source": { "enum": ["own-file", "library", "fetched", "card", "animation", "screen-recording"] },
              "asset": { "anyOf": [{ "$ref": "#/$defs/relPath" }, { "type": "null" }] },
              "treatment": { "type": "string", "description": "how it is shown (a broll treatment); absent = the source's default" },
              "status": { "enum": ["proposed", "approved", "rejected"] },
              "hold": { "type": "number", "minimum": 0, "maximum": 60, "description": "seconds it should stay up: a hint; the anchor's words decide the real length" },
              "note": { "type": "string" },
              "broll": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", "description": "the broll item this row built" }
            }
          }
        },
        "music": { "type": "string", "description": "the music choice, one line" },
        "cover": { "type": "string", "description": "the cover idea, one line" },
        "buildProposed": { "type": "boolean", "description": "build proposed rows as if approved; absent = only approved rows are built" }
      }
    }
  },
  "$defs": {
    "wordId": { "type": "string", "pattern": "^w[0-9]+$" },
    "wordRange": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/wordId" }, "to": { "$ref": "#/$defs/wordId" } }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "description": "relative to the project (media/..., work/...) or the Reel Studio root (Library/...). No absolute, drive, UNC or '..' paths: the engine also re-checks the resolved real path.",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!(.*[\\\\/])?\\.\\.([\\\\/]|$))[^\\u0000]+$"
    }
  }
}
