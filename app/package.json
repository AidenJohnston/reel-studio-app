{
  "name": "@reelstudio/app",
  "productName": "Reel Studio",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "description": "Turn a raw talking-head video into a finished Reel.",
  "author": {
    "name": "Reel Studio"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@reelstudio/ai": "*"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
