{
  "name": "reel-studio",
  "private": true,
  "version": "0.1.4",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "app",
    "ai"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w ai && npm run build -w app",
    "start": "npm run start -w app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run build -w ai && npm run e2e -w app",
    "check:changed": "node scripts/ci/changes.mjs --run",
    "prepare": "node scripts/leak-check/install-hooks.mjs"
  }
}
