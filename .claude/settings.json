{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/scripts/leak-check/with-python.sh\" --agent-hook \"${CLAUDE_PROJECT_DIR}/scripts/leak-check/agent_hook.py\"",
            "timeout": 30,
            "onFailure": "continue",
            "statusMessage": "Leak check on gh text"
          }
        ]
      }
    ]
  }
}
