{
  "id": "stat-count-up",
  "name": "Number count-up",
  "description": "A big number counts up to the value that is said, with a short label under it. Use when the speaker says one striking number (\"3,000 people\", \"92%\", \"$1.5M\").",
  "defaultDuration": 3,
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "value"
    ],
    "properties": {
      "value": {
        "type": "string",
        "minLength": 1,
        "maxLength": 14,
        "description": "The number exactly as said, in digits, with its unit: \"3,000\", \"92%\", \"$1.5M\", \"4.8\"."
      },
      "text": {
        "type": "string",
        "maxLength": 60,
        "description": "Short label under the number, 2 to 6 words: \"people signed up\"."
      },
      "from": {
        "type": "number",
        "default": 0,
        "description": "Number the count starts from."
      },
      "countDuration": {
        "type": "number",
        "minimum": 0.2,
        "maximum": 3,
        "default": 1.0,
        "description": "Seconds the count takes."
      },
      "labelAt": {
        "type": "number",
        "minimum": 0,
        "default": 0.12,
        "description": "Seconds from the start when the label lands."
      },
      "layout": {
        "type": "string",
        "enum": [
          "top",
          "full"
        ],
        "default": "top",
        "description": "top = card above the head, speaker stays visible. full = covers the frame (speaker hidden)."
      },
      "theme": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "accent"
        ],
        "default": "light",
        "description": "light = warm white card, dark = near-black card, accent = card in the accent colour."
      },
      "accentColor": {
        "type": "string",
        "pattern": "^#?[0-9a-fA-F]{6}$",
        "description": "Optional accent colour, e.g. #2F5BFF."
      },
      "tilt": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -8,
        "maximum": 8,
        "default": null,
        "description": "Tilt in degrees. Default -2 for top, 0 for full."
      },
      "duration": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 30,
        "description": "Clip length in seconds. Leave out to use the template's own length."
      },
      "drift": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.08,
        "default": 0.015,
        "description": "Slow push-in over the clip (0 = perfectly still)."
      },
      "region": {
        "$ref": "#/definitions/region"
      }
    },
    "definitions": {
      "region": {
        "type": "object",
        "description": "Optional box (frame px, 1080x1920) the content must stay inside; the engine passes the free space above the face.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false
      }
    }
  },
  "example": {
    "value": "3,000",
    "text": "people signed up in a week"
  },
  "variants": [
    {
      "value": "92%",
      "text": "finished the whole course",
      "theme": "dark"
    },
    {
      "value": "$1.5M",
      "text": "in the first year",
      "layout": "full",
      "theme": "accent"
    }
  ]
}
