{
  "id": "list-reveal",
  "name": "List, one item at a time",
  "description": "A list of 2 to 5 short items builds one row per beat, the newest row in focus. Use when the speaker counts things off (\"three things: ...\").",
  "defaultDuration": 3.5,
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 5,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": "2 to 5 items, each 1 to 4 words, in the order they are said."
      },
      "text": {
        "type": "string",
        "maxLength": 50,
        "description": "Optional title above the list."
      },
      "numbered": {
        "type": "boolean",
        "default": true,
        "description": "Number chips (true) or dots (false)."
      },
      "at": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        },
        "maxItems": 5,
        "description": "Optional: seconds from the clip start when each item lands (from the transcript)."
      },
      "itemStep": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 3,
        "default": 0.5,
        "description": "Seconds between items when `at` is not given."
      },
      "focus": {
        "type": "boolean",
        "default": true,
        "description": "Earlier items step back (muted) when a new one lands."
      },
      "layout": {
        "type": "string",
        "enum": [
          "top",
          "full"
        ],
        "default": "top",
        "description": "top = card above the head, speaker stays visible. full = covers the frame (speaker hidden)."
      },
      "theme": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "accent"
        ],
        "default": "light",
        "description": "light = warm white card, dark = near-black card, accent = card in the accent colour."
      },
      "accentColor": {
        "type": "string",
        "pattern": "^#?[0-9a-fA-F]{6}$",
        "description": "Optional accent colour, e.g. #2F5BFF."
      },
      "tilt": {
        "type": [
          "number",
          "null"
        ],
        "minimum": -8,
        "maximum": 8,
        "default": null,
        "description": "Tilt in degrees. Default -1.5 for top, 0 for full."
      },
      "duration": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 30,
        "description": "Clip length in seconds. Leave out to use the template's own length."
      },
      "drift": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.08,
        "default": 0.015,
        "description": "Slow push-in over the clip (0 = perfectly still)."
      },
      "region": {
        "$ref": "#/definitions/region"
      }
    },
    "definitions": {
      "region": {
        "type": "object",
        "description": "Optional box (frame px, 1080x1920) the content must stay inside; the engine passes the free space above the face.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false
      }
    }
  },
  "example": {
    "text": "My editing stack",
    "items": [
      "Rough cut",
      "Captions",
      "Music",
      "B-roll"
    ]
  },
  "variants": [
    {
      "items": [
        "Hook",
        "Story",
        "Call to action"
      ],
      "numbered": false,
      "theme": "dark"
    },
    {
      "text": "Three rules",
      "items": [
        "Film daily",
        "Cut the pauses",
        "Post anyway"
      ],
      "layout": "full",
      "theme": "accent"
    }
  ]
}
